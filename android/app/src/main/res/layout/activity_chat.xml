<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- CHAT HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@color/surface">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="@null"
            android:tint="@color/text_primary"/>

        <TextView
            android:id="@+id/tv_chat_initials"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/accent_blue"
            android:background="@drawable/circle_avatar"
            android:layout_marginStart="8dp"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/tv_chat_name" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tv_chat_status" android:textSize="11sp" android:textColor="@color/accent_green" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <TextView android:text="📞" android:textSize="22sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- MESSAGES -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        android:clipToPadding="false"/>

    <!-- INPUT BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:background="@color/surface">

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type a message..."
            android:hintTextColor="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:inputType="textMultiLine"
            android:maxLines="4"/>

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="@drawable/circle_send"
            android:tint="@color/white"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</LinearLayout>
