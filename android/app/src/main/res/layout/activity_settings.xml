<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:gravity="center_vertical" android:background="@color/surface">
        <ImageButton android:id="@+id/btn_settings_back" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_media_previous" android:background="@null" android:tint="@color/text_primary"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:text="Settings ⚙️" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Configure your AI bot" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <!-- BOT IDENTITY -->
            <TextView android:text="BOT IDENTITY" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_secondary" android:letterSpacing="0.08" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="16dp" app:strokeColor="@color/card_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                    <TextView android:text="Bot Name" android:textSize="11sp" android:textColor="@color/text_secondary" android:textAllCaps="true" android:letterSpacing="0.06" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/et_bot_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="e.g. Priya" android:hintTextColor="@color/text_secondary" android:textColor="@color/text_primary" android:background="@drawable/input_bg" android:paddingHorizontal="14dp" android:paddingVertical="10dp" android:layout_marginBottom="14dp" android:inputType="text"/>

                    <TextView android:text="Business Name" android:textSize="11sp" android:textColor="@color/text_secondary" android:textAllCaps="true" android:letterSpacing="0.06" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/et_business_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="e.g. Patel Traders" android:hintTextColor="@color/text_secondary" android:textColor="@color/text_primary" android:background="@drawable/input_bg" android:paddingHorizontal="14dp" android:paddingVertical="10dp" android:layout_marginBottom="14dp" android:inputType="text"/>

                    <TextView android:text="Your WhatsApp Number" android:textSize="11sp" android:textColor="@color/text_secondary" android:textAllCaps="true" android:letterSpacing="0.06" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/et_wa_number" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="+91 9800000000" android:hintTextColor="@color/text_secondary" android:textColor="@color/text_primary" android:background="@drawable/input_bg" android:paddingHorizontal="14dp" android:paddingVertical="10dp" android:inputType="phone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BOT BEHAVIOR -->
            <TextView android:text="BOT BEHAVIOR" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_secondary" android:letterSpacing="0.08" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="16dp" app:strokeColor="@color/card_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:text="Auto-detect language" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="Reply in caller's language" android:textSize="11sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sw_auto_lang" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/card_border"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:text="Send WA summary always" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="Even if bot resolved it" android:textSize="11sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sw_send_wa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/card_border"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:text="Record all calls" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="Store transcript + audio" android:textSize="11sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sw_record" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/card_border"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:text="Flag urgent calls" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="Add ⚠️ if action needed" android:textSize="11sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sw_urgent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- API KEYS -->
            <TextView android:text="API KEYS" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_secondary" android:letterSpacing="0.08" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="16dp" app:strokeColor="@color/card_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                    <TextView android:text="Twilio Account SID" android:textSize="11sp" android:textColor="@color/text_secondary" android:textAllCaps="true" android:letterSpacing="0.06" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/et_twilio_sid" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ACxxxxxxxxxxxxxxxxx" android:hintTextColor="@color/text_secondary" android:textColor="@color/text_primary" android:background="@drawable/input_bg" android:paddingHorizontal="14dp" android:paddingVertical="10dp" android:layout_marginBottom="14dp" android:inputType="textPassword"/>

                    <TextView android:text="Twilio Auth Token" android:textSize="11sp" android:textColor="@color/text_secondary" android:textAllCaps="true" android:letterSpacing="0.06" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/et_twilio_token" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="••••••••••••••••" android:hintTextColor="@color/text_secondary" android:textColor="@color/text_primary" android:background="@drawable/input_bg" android:paddingHorizontal="14dp" android:paddingVertical="10dp" android:layout_marginBottom="14dp" android:inputType="textPassword"/>

                    <TextView android:text="Anthropic (Claude) API Key" android:textSize="11sp" android:textColor="@color/text_secondary" android:textAllCaps="true" android:letterSpacing="0.06" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/et_claude_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="sk-ant-••••••••••" android:hintTextColor="@color/text_secondary" android:textColor="@color/text_primary" android:background="@drawable/input_bg" android:paddingHorizontal="14dp" android:paddingVertical="10dp" android:layout_marginBottom="14dp" android:inputType="textPassword"/>

                    <TextView android:text="Deepgram API Key" android:textSize="11sp" android:textColor="@color/text_secondary" android:textAllCaps="true" android:letterSpacing="0.06" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/et_deepgram_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="••••••••••••••••" android:hintTextColor="@color/text_secondary" android:textColor="@color/text_primary" android:background="@drawable/input_bg" android:paddingHorizontal="14dp" android:paddingVertical="10dp" android:inputType="textPassword"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button android:id="@+id/btn_save_settings" android:layout_width="match_parent" android:layout_height="52dp" android:text="💾 Save All Settings" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/white" android:backgroundTint="@color/accent_blue" android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
